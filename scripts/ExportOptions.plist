<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Developer ID = direct distribution outside the Mac App Store.
         The exported .app is signed with the user's Developer ID
         Application certificate; gets paired with notarization for
         Gatekeeper to silently pass it on download. -->
    <key>method</key>
    <string>developer-id</string>

    <!-- Automatic signing. We used to pin signingStyle: manual + an
         explicit provisioningProfiles map ("Mac Team Direct Provisioning
         Profile: com.gavin.doris") to dodge cloud-signing. But that
         profile is Xcode-MANAGED, and Xcode 26.4.1's exportArchive now
         hard-rejects a managed profile under manual signing:
           "Provisioning profile … is Xcode managed, but signing
            settings require a manually managed profile."
         Automatic signing (with -allowProvisioningUpdates + the ASC API
         key, both passed by release.sh) lets Xcode resolve the managed
         Developer ID profile itself and sign with the locally-installed
         "Developer ID Application" cert. Verified: the exported .app +
         embedded CLI are Developer ID signed with hardened runtime and
         pass `codesign --verify --deep --strict`. This mirrors the iOS
         path (scripts/ExportOptions-iOS.plist), which is also automatic. -->
    <key>signingStyle</key>
    <string>automatic</string>

    <!-- DORIS_TEAM_ID is exported by scripts/release.sh; xcodebuild
         interpolates $(DORIS_TEAM_ID) from project.yml settings too,
         so the two stay in lockstep. -->
    <key>teamID</key>
    <string>$(DORIS_TEAM_ID)</string>

    <!-- Strip Swift debug symbols out of the exported bundle to keep
         the DMG small; the .xcarchive still has them if we ever need
         to symbolicate a crash report. -->
    <key>stripSwiftSymbols</key>
    <true/>

    <!-- Required by hardened-runtime apps to be notarizable. -->
    <key>compileBitcode</key>
    <false/>
</dict>
</plist>
