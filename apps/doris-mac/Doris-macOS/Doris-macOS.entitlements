<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.gavin.doris.shared</string>
    </array>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <!-- Integration registration writes the user's real ~/.claude
         (Claude Code Stop hook) and ~/.codex (Codex notify dispatcher).
         ~/.doris holds the CLI<->app IPC inbox — moved out of the App-Group
         container so the Claude/Codex `doris notify` hooks (run by those CLIs)
         don't trip macOS's "wants to access other apps' data" prompt on every
         run. A sandboxed app's home is its container, so without these the
         writes land in the jail. Allowed for Developer-ID distribution
         (App Store would scrutinize these). -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
    <array>
        <string>/.codex/</string>
        <string>/.claude/</string>
        <string>/.doris/</string>
        <!-- Token usage from LM Studio's chat history. Read-only in practice
             (LMStudioAdapter never writes), but this exception key has no
             read-only variant for home-relative paths. Without it the adapter
             silently returns zero samples in the sandboxed build while working
             fine in an unsandboxed dev run. -->
        <string>/.lmstudio/</string>
    </array>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.developer.icloud-services</key>
    <array>
        <string>CloudKit</string>
    </array>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
        <string>iCloud.com.gavin.doris</string>
    </array>
    <!-- Pin CloudKit to the Production database for EVERY build, including
         local Debug runs from Xcode.

         Without this key CloudKit picks its environment from the signature:
         an Apple-Development-signed build (what `Run` produces) silently
         lands in the *Development* database, while the notarized DMG and the
         iPhone sit in Production. Nothing errors — mirroring reports success
         and `ZNEEDSUPLOAD` goes to 0 — the records just go into a database no
         other device reads. That cost us three months of notes diverging on
         one Mac before anyone noticed.

         Editing `aps-environment` alone cannot fix it: Xcode's automatic
         signing rewrites that key to match the provisioning profile type, so
         a Debug build gets `development` no matter what this file says.
         `icloud-container-environment` is not rewritten, and the Mac Team
         Provisioning Profile authorizes both values
         (`[Production, Development]`), so a Development-signed build may
         legally claim Production — keeping Xcode debugging fully intact.

         The release re-sign in scripts/release-mac-zip.sh writes this same
         key; declaring it here makes local builds match the shipped app
         instead of quietly diverging. -->
    <key>com.apple.developer.icloud-container-environment</key>
    <string>Production</string>
    <key>com.apple.developer.aps-environment</key>
    <string>production</string>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)group.com.gavin.doris.shared</string>
    </array>
</dict>
</plist>
